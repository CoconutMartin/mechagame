horizontal_alignment = 2
autowrap_mode = 3
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 14
text = "W / S walk   A / D turn legs   Mouse: aim (camera stays behind the torso)
RMB fire (hip)   LMB lift shield   V front view
Space hold: charge jump jets, release to jump (W or S held: jump that way)
Space double tap: dodge hop (A / D side, W forward, S or none back; forward while boosting)
Shift + W: walk 2 steps, run 2 steps, then boost   Ctrl kneel
Mouse moves the blue ring inside a small box; past the edge the camera turns
Yellow dot = camera crosshair   Blue ring = mech aim
Grid lines: thin = 1 m, thick = 10 m"
